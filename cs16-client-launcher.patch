-	{
-		gRenderAPI.Host_Error("Xash3D FWGS version check failed!\nPlease update your Xash3D FWGS!\n");
-	}
-
+	// An older engine used to be a Host_Error here, which closed the game with
+	// "Please update your Xash3D FWGS!" before anything drew. The client and the
+	// engine are paired by the launcher and by the packager, and a player has no
+	// way to update one from inside the other, so the only thing the error did
+	// was make the game unstartable. Initialize() reports the mismatch on the
+	// console instead, and the client runs.
 	return true;
 }
 
@@ -482,13 +490,15 @@ HUD_MobilityInterface
 */
 int DLLEXPORT HUD_MobilityInterface( mobile_engfuncs_t *mobileapi )
 {
+	// Same as the engine check above: a mismatch is reported, not fatal. The
+	// mobile table is filled in from the engine's copy, so on a real layout
+	// difference the touch callbacks below would be called through the wrong
+	// offsets - but the engine is the one nexora ships against, and refusing to
+	// start leaves the player with a black screen and no way to say so.
 	if( mobileapi->version != MOBILITY_API_VERSION )
 	{
 		gEngfuncs.Con_Printf("Client Error: Mobile API version mismatch. Got: %i, want: %i\n",
 			mobileapi->version, MOBILITY_API_VERSION);
-
